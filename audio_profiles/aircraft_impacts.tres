&"metal_tear": ExtResource("event_metal_tear"),
&"fabric_tear": ExtResource("event_fabric_tear"),
&"engine_misfire": ExtResource("event_engine_misfire"),
&"engine_seizure": ExtResource("event_engine_seizure"),

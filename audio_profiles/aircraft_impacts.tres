&"structural_breakup": ExtResource("event_structural_breakup"),
&"propeller_impact": ExtResource("event_propeller_impact"),
&"hard_landing": ExtResource("event_hard_landing"),
&"ground_crash": ExtResource("event_ground_crash"),
&"secondary_impact": ExtResource("event_secondary_impact")
}
